<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="aaaStart1COnRemoteComp.MainLayoutController">

    <center>
        <ListView fx:id="listView" />
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Button fx:id="addButton" onAction="#onAdd" text="Добавить" />
            <Button fx:id="editButton" onAction="#onEdit" text="Редактировать" />
            <Button fx:id="deleteButton" onAction="#onDelete" text="Удалить" />
        </HBox>
    </bottom>

</BorderPane>
